Set Shell bash
Set FontFamily "Menlo"
Set FontSize 16
Set Width 1280
Set Height 780
Set Framerate 12
# Dark badge backgrounds retain contrast with the inherited foreground.
Set Theme { "name": "dmon demo", "background": "#1e1e2e", "foreground": "#cdd6f4", "black": "#45475a", "red": "#f38ba8", "green": "#006b35", "yellow": "#f9e2af", "blue": "#89b4fa", "magenta": "#f5c2e7", "cyan": "#94e2d5", "white": "#bac2de", "brightBlack": "#585b70", "brightRed": "#9e2436", "brightGreen": "#a6e3a1", "brightYellow": "#f9e2af", "brightBlue": "#89b4fa", "brightMagenta": "#f5c2e7", "brightCyan": "#94e2d5", "brightWhite": "#a6adc8", "selection": "#585b70", "cursor": "#f5e0dc" }
Set TypingSpeed 25ms
Set Padding 8
Set Margin 0
Set BorderRadius 0
